# =============================================================================
# EDITORCONFIG — Cross-Editor Consistency
# =============================================================================
# ARCHITECTURE DECISION: EditorConfig ensures consistent indentation and
# line endings across all team members regardless of IDE choice.
# Terraform uses 2-space indentation; Go uses tabs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{tf,tfvars}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
