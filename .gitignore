# =============================================================================
# GITIGNORE — Terraform + Development Artifacts
# =============================================================================
# SECURITY SAFEGUARD: Never commit .tfstate files — they contain sensitive
# infrastructure details (account IDs, private IPs, resource identifiers).
# SECURITY SAFEGUARD: Never commit .tfvars files with real credentials.
# Use terraform.tfvars.example and keep actual values in Vault/Terraform Cloud.

# Local .terraform directories
**/.terraform/*
*.tfstate
*.tfstate.*.backup
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files except .example
*.tfvars
!.terraform.tfvars.example
!terraform.tfvars.example
!envs/**/terraform.tfvars

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terratest / Go binaries
*.test
*.out
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Infracost
infracost.json
.infracost-usage.yml

# Plan artifacts
tfplan-*
